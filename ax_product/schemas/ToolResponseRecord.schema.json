{
  "additionalProperties": false,
  "properties": {
    "output": {
      "additionalProperties": true,
      "title": "Output",
      "type": "object"
    },
    "output_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Output Sha256",
      "type": "string"
    },
    "run_id": {
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "ax-tool-response-v1",
      "default": "ax-tool-response-v1",
      "title": "Schema Version",
      "type": "string"
    },
    "sequence": {
      "minimum": 1,
      "title": "Sequence",
      "type": "integer"
    },
    "tool_name": {
      "enum": [
        "search_documents",
        "read_document",
        "lookup_value",
        "query_table"
      ],
      "title": "Tool Name",
      "type": "string"
    }
  },
  "required": [
    "run_id",
    "sequence",
    "tool_name",
    "output",
    "output_sha256"
  ],
  "title": "ToolResponseRecord",
  "type": "object"
}
