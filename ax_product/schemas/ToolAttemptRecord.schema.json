          "type": "array"
        },
        "parameter_names": {
          "items": {
            "type": "string"
          },
          "title": "Parameter Names",
          "type": "array"
        },
        "query_character_count": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Query Character Count"
        },
        "result_limit": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Result Limit"
        },
        "source_ids": {
          "items": {
            "type": "string"
          },
          "title": "Source Ids",
          "type": "array"
        }
      },
      "required": [
        "parameter_names",
        "source_ids",
        "filter_fields"
      ],
      "title": "ToolRequestSummary",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "error_code": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error Code"
    },
    "request_summary": {
      "$ref": "#/$defs/ToolRequestSummary"
    },
    "run_id": {
      "minLength": 1,
