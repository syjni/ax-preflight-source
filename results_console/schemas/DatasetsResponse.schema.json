{
  "$defs": {
    "DatasetOption": {
      "additionalProperties": false,
      "properties": {
        "dataset_name": {
          "minLength": 1,
          "title": "Dataset Name",
          "type": "string"
        },
        "display_label": {
          "minLength": 1,
          "title": "Display Label",
          "type": "string"
        },
        "origin": {
          "default": "BUNDLED",
          "enum": [
            "BUNDLED",
            "LOCAL"
          ],
          "title": "Origin",
          "type": "string"
        },
        "profile": {
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9-]*$",
          "title": "Profile",
          "type": "string"
        },
        "scanned_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scanned At"
        },
        "source_root_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Root Name"
        }
      },
      "required": [
        "profile",
        "dataset_name",
        "display_label"
      ],
      "title": "DatasetOption",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "datasets": {
      "items": {
        "$ref": "#/$defs/DatasetOption"
      },
      "title": "Datasets",
      "type": "array"
    },
    "schema_version": {
      "const": "ax-datasets-response-v1",
      "default": "ax-datasets-response-v1",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "datasets"
  ],
  "title": "DatasetsResponse",
  "type": "object"
}
