{
  "additionalProperties": false,
  "properties": {
    "attempt_count": {
      "minimum": 1,
      "title": "Attempt Count",
      "type": "integer"
    },
    "completed_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Completed At"
    },
    "completed_stages": {
      "items": {
        "type": "string"
      },
      "title": "Completed Stages",
      "type": "array"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "dataset_profile": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Dataset Profile"
    },
    "deletion_status": {
      "enum": [
        "PARTIAL_FAILURE",
        "COMPLETED"
      ],
      "title": "Deletion Status",
      "type": "string"
    },
    "failure_code": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Failure Code"
    },
    "failure_detail": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Failure Detail"
    },
    "operation_id": {
      "pattern": "^del_[a-f0-9]{32}$",
      "title": "Operation Id",
      "type": "string"
    },
    "project_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Project Id"
    },
    "remaining_records": {
      "items": {
        "type": "string"
      },
      "title": "Remaining Records",
      "type": "array"
    },
    "remaining_stages": {
      "items": {
        "type": "string"
      },
      "title": "Remaining Stages",
      "type": "array"
    },
    "schema_version": {
      "const": "ax-deletion-operation-v1",
      "default": "ax-deletion-operation-v1",
      "title": "Schema Version",
      "type": "string"
    },
    "scope": {
      "enum": [
        "PROJECT",
        "DATASET"
      ],
      "title": "Scope",
      "type": "string"
    },
    "source_files_deleted": {
      "const": false,
      "default": false,
      "title": "Source Files Deleted",
      "type": "boolean"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    }
  },
  "required": [
    "operation_id",
    "scope",
    "deletion_status",
    "completed_stages",
    "remaining_stages",
    "remaining_records",
    "attempt_count",
    "created_at",
    "updated_at"
  ],
  "title": "DeletionOperationView",
  "type": "object"
}
